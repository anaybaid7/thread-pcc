{
  "name": "thread",
  "private": true,
  "type": "module",
  "workspaces": ["engine", "server", "web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
