# THREAD server configuration. Copy to .env (never commit .env) and fill in what you have.
# Everything is optional: with nothing set, the API uses an embedded PostgreSQL (PGlite) in .data/pglite
# and handover drafts use the deterministic template.

# ── Database ────────────────────────────────────────────────────────────────
# Vultr Managed PostgreSQL: Products → Databases → your cluster → Overview → Connection Details → Copy PostgreSQL URL.
# Looks like: postgresql://vultradmin:<password>@<cluster>.vultrdb.com:<port>/defaultdb?sslmode=require
DATABASE_URL=

# TLS. Remote hosts default to "require" (encrypted). For certificate verification, download the cluster's signed
# certificate from Connection Details and point DATABASE_CA_CERT at the file (or paste the PEM); this switches to
# "verify-full". Local hosts default to "disable". Override with DATABASE_SSL=disable|require|verify-full.
DATABASE_CA_CERT=
DATABASE_SSL=
DATABASE_POOL_MAX=5

# Embedded PostgreSQL directory when DATABASE_URL is empty ("memory" for a throwaway in-memory database).
PGLITE_DIR=.data/pglite

# ── Gemini (server-side only; never exposed to the browser) ───────────────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried once if the main model is busy (HTTP 429/5xx). "none" to disable.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_REQUESTS_PER_HOUR=60

# ── API server ──────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
